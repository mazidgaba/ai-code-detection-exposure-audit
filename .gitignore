# Corpora, model weights and anything else downloaded or trained. None of it is
# ours to redistribute, and it runs to several gigabytes.
aicd/artifacts/
*.parquet
*.pt
*.bin
*.safetensors
*.pkl
*.ckpt

# Credentials. Never commit any of these.
.kaggle/
kaggle.json
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
.netrc

# Local run output that lands in the reports directory but is terminal noise
# rather than a measurement: a dev-server startup log, and smoke tests whose
# output is mostly progress bars.
aicd/eval/reports/api_log.txt
aicd/eval/reports/branch_a_verify.txt
aicd/eval/reports/smoke.json

# The manuscript. Not distributed until the paper is published.
paper/main.tex
paper/main.pdf
paper/figures/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.synctex.gz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
